# Front controller: tutto ciò che non è un file reale passa da index.php.
# Da usare quando il document root del dominio punta a questa cartella
# (su SiteGround: Site Tools → Dominio → Document root).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # File e cartelle esistenti (immagini, css, install.php) vengono serviti così.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>

# Le foto caricate non devono poter essere eseguite come codice: la regola
# sta in `uploads/.htaccess`, non qui. `<Directory>` dentro un .htaccess non
# e ammessa e fa rispondere 500 all'intero sito, e `php_flag` fa lo stesso
# dove PHP gira in FPM invece che come modulo Apache — cioe su SiteGround.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# ATTENZIONE — non aggiungere righe a questo file senza provarle sul server.
#
# Il 6 agosto 2026 qui dentro erano state aggiunte tre righe di cache per
# SVG e caratteri tipografici (`ExpiresByType image/svg+xml`, `font/woff2`,
# `application/font-woff2`). Su SiteGround il sito ha smesso di rispondere
# su ogni indirizzo tranne la home: 404 su /immobili/, sulle schede, su
# tutto. Non un 500 — un 404, e con la pagina di errore di SiteGround, non
# con quella del sito. Cioe la richiesta non arrivava nemmeno a PHP.
#
# Le stesse tre righe, su un Apache normale con mod_rewrite e mod_expires,
# non rompono niente: provate, /immobili/ e /contatti/ rispondono 200. Il
# problema e nel modo in cui SiteGround legge questo file — davanti ad
# Apache c'e un NGINX che se lo rilegge per conto suo, ed e lui a
# rispondere quel 404. Quale delle tre righe non gli piaccia non e stato
# stabilito: costava un'altra interruzione del sito per scoprirlo, e il
# guadagno era qualche KB di cache.
#
# Se un giorno serve davvero: una riga per volta, provando /immobili/
# dopo ognuna, e con una copia di questo file da rimettere al suo posto.
