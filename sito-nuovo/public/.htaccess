# Front controller: tutto ciò che non è un file reale passa da index.php.
# Da usare quando il document root del dominio punta a questa cartella
# (su SiteGround: Site Tools → Dominio → Document root).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # File e cartelle esistenti (immagini, css, install.php) vengono serviti così.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>

# Le foto caricate non devono poter essere eseguite come codice: la regola
# sta in `uploads/.htaccess`, non qui. `<Directory>` dentro un .htaccess non
# e ammessa e fa rispondere 500 all'intero sito, e `php_flag` fa lo stesso
# dove PHP gira in FPM invece che come modulo Apache — cioe su SiteGround.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Il carattere tipografico e il file piu pesante servito dal sito: 38 KB,
  # piu di tutto il resto messo insieme. Mancava dall'elenco, quindi veniva
  # riscaricato di continuo. L'indirizzo porta gia il ?v= che cambia quando
  # cambia il file, percio tenerlo un anno non rischia di servirne uno vecchio.
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
